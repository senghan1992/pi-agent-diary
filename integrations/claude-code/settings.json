{
	"hooks": {
		"SessionStart": [
			{ "hooks": [{ "type": "command", "command": "ad hook session-start", "timeout": 10 }] }
		],
		"UserPromptSubmit": [
			{ "hooks": [{ "type": "command", "command": "ad hook prompt", "timeout": 10 }] }
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
				"hooks": [{ "type": "command", "command": "ad hook post-tool", "timeout": 10 }]
			}
		],
		"Stop": [
			{ "hooks": [{ "type": "command", "command": "ad hook stop", "timeout": 10 }] }
		]
	}
}
